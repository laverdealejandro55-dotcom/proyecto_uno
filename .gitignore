# ===== Visual Studio / ASP.NET Web Forms (.NET Framework) =====

# Carpeta de configuración local de Visual Studio
.vs/

# Archivos de usuario
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Resultados de compilación
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Ll]og/
[Ll]ogs/

# Paquetes NuGet (se restauran con "Restaurar paquetes NuGet")
[Pp]ackages/
!**/[Pp]ackages/build/
*.nupkg
*.snupkg
project.lock.json
.nuget/

# Cachés y archivos temporales de compilación
*.cache
*.pdb
*.ilk
*.obj
*.tmp
*.tmp_proj
*.log
*.vspscc
*.vssscc
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.idea/

# Publicación
PublishScripts/
*.pubxml
*.pubxml.user
*.publishproj
[Pp]ublish/
csc.rsp.bak

# Pruebas
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# Copilot / índices de IDE
CopilotIndices/

# Sistema operativo
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Secretos locales (por si se agregan después)
appsettings.Development.json
secrets.json
*.pfx
.env
